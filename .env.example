# Generate a URL-safe database password, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-64-character-hex-secret

# Generate a distinct API key with at least 16 characters:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EG_API_KEYS=operator:admin:replace-with-a-long-random-api-key

# Path to the scope file declaring which hosts you are authorised to scan.
EG_SCOPE_FILE=./scope.yaml
